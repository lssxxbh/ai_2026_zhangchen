# 阿里云百联API配置
# 请从 https://bailian.console.aliyun.com/ 获取
OPENAI_API_KEY=your_api_key_here

# LLM API 基础地址（可选，默认: https://dashscope.aliyuncs.com/compatible-mode/v1）
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM 模型名称（可选，默认: qwen-plus）
# 可选值: qwen-turbo, qwen-plus, qwen-max
LLM_MODEL=qwen3.7-plus

# LLM 提供商（可选，默认: aliyun）
LLM_PROVIDER=aliyun

# 数据库配置（可选）
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/medical_ai?charset=utf8mb4


# 报告生成 API
REPORT_GENERATION_API_URL=http://10.187.79.121:8000/api/v1/reports/from-ocr-json/simple
